# Python bytecode
__pycache__/
*.py[cod]

# Rust build output (examples/edge-rust)
examples/edge-rust/target/
examples/edge-rust/dist/
examples/edge-rust/.bench/

# Host local state (examples/host): captures, certs, per-phone calibration,
# printable tags and generated plans are machine-specific
examples/host/state/
examples/host/.env
examples/host/tests/.selftest-work/
examples/host/tests/.e2e-*

# Local tooling / venvs (machine-specific, not part of the guide)
.rebot-venv/
.venv/
.uv-cache/
.uv-python/

# Editors
.vscode/
.idea/
*.swp

# OS clutter
.DS_Store
Thumbs.db
desktop.ini
