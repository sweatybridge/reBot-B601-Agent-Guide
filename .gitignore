# Python bytecode
__pycache__/
*.py[cod]

# Rust build output (examples/edge-rust)
examples/edge-rust/target/
examples/edge-rust/dist/
examples/edge-rust/.bench/

# Host local state (examples/host): captures, certs, per-phone calibration,
# printable tags and generated plans are machine-specific
examples/host/state/
examples/host/work/
examples/host/.env
examples/host/tests/.selftest-work/
examples/host/tests/.browser-check-work/
examples/host/tests/.e2e-*

# Flattened deploy config (§8): TLS secrets are machine-specific; export/ is
# derived handoff staging, not a source of truth.
examples/host/config/tls/*.pem
examples/host/export/

# CAD visual meshes (~37 MB, fetched on demand by app/cad/fetch.py)
examples/host/app/cad/meshes/

# Local tooling / venvs (machine-specific, not part of the guide)
.rebot-venv/
.venv/
.uv-cache/
.uv-python/

# Editors
.vscode/
.idea/
*.swp

# OS clutter
.DS_Store
Thumbs.db
desktop.ini
