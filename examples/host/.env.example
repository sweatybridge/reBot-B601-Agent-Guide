# Copy to .env and edit. Compose reads this file from this directory.
#
# The LAN address the phone can reach. After the WHIP handshake the phone sends
# video to <REBOT_HOST_IP>:8189/udp; a container's own IP would not work. It is
# also the address the certificate is issued for.
REBOT_HOST_IP=192.168.1.23

# Shared secret required on every upload and on /execute. Empty means "open on
# the LAN"; the arm gateway refuses /execute without the flag below, whatever
# this is set to.
REBOT_TOKEN=pick-something
REBOT_PLANNER_TOKEN=pick-something-internal

# Host port for the capture page.
REBOT_PORT=8443

# --- Where is the camera? ---------------------------------------------------
# A fitted rig is read from state/calib/extrinsics-fixed.json at startup.
# Fit it once: with the base tag in view, press Capture one pose on the Rig card
# (or run `calibrate_extrinsics.py --capture-pose`).
# Without the tag, sweep the arm:
#     docker compose --profile tools run --rm tools app/calibrate_extrinsics.py --auto --from <capture> --uv U V
# Until a rig exists, taps use the handheld ArUco path below.
# Refuse a capture whose background moved more than this since the fit, in
# pixels. 2 px is under 1 mm at 1 m with a phone sensor.
REBOT_WITNESS_MAX_PX=2.0
# The camera the automatic sweep uses. It must be the stream MediaMTX serves:
# the sweep is recorded by MediaMTX, so a snapshot URL or a USB device cannot be
# used here.
REBOT_CAMERA=rtsp://mediamtx:8554/phone
# Where MediaMTX writes recordings (`recordings/phone/*.mp4` on the host, /app/state
# inside the capture container) and the control API that starts and stops them.
REBOT_RECORDINGS=/app/state/recordings
REBOT_MEDIAMTX_API=http://mediamtx:9997

# Height of the surface being tapped, in the base frame.
REBOT_PLANE_Z=0.0
# The ArUco tag, in the arm's base frame: "x,y,z[,yaw[,id]]" in metres and
# DEGREES. Paste it upright on the side of the base and give the heading its
# printed face points to (180 for the -x face). Handheld mode solves the camera
# from it on every tap; fixed mode reads it in the calibration capture and writes
# the rig from that one still, with no sweep. SIZE is the BLACK SQUARE's side,
# border included -- measure across the black, not the white margin: a 4 cm black
# square is 0.04. (The 4x4 pattern inside the border is only 4/6 of that, so do
# not measure it by mistake.)
REBOT_MARKER_AT=0.000,0.047,0.043,90
REBOT_MARKER_SIZE=0.04

# Height of the tap plane above the worktop, in metres. The phone intersects the
# tap ray with this plane, so x/y move with height. Also the lowest tip z the
# planner accepts, so the height badge bottoms out here.
REBOT_HOVER_M=0.04
# The tool tip below the flange, in mm. The reference gripper is 35. A tap
# height becomes a tip point; the planner lifts the flange by this offset.
REBOT_TIP_MM=35
# Which local axis of gripper_end should point at the table (run `--inspect`),
# and the gripper yaw about vertical.
REBOT_TOOL_AXIS=current
REBOT_YAW=0

# The Pi, running `rebot-edge serve`. This is the only way the host reaches the
# arm: no ssh, no keys, no files copied onto the board.
REBOT_EDGE_URL=http://raspberrypi:8081
REBOT_EDGE_TOKEN=the-token-you-gave-rebot-edge-serve

# 0 = taps only produce trajectories on disk. 1 = the viewers also offer
# "Move the arm", behind a two-step confirm. The edge must also be started with
# --allow-execute; both flags are required.
REBOT_EXECUTE=0

# --- The agent sidebar on /live ---------------------------------------------
# An OpenAI-compatible chat endpoint. The model does the scene understanding: it
# reads one still from the camera and answers in image pixels, and the page turns
# that into arm coordinates through the fitted rig. Configure it here only -- the
# page has no settings, cannot see this key, and cannot change the model.
#
# Inside compose, localhost is the container, so the host's Ollama is reached by
# its gateway name. Running capture_server.py directly, the default
# http://localhost:11434/... already points at the host. Set REBOT_LLM_URL= to
# turn the sidebar off.
REBOT_LLM_URL=http://host.docker.internal:11434/v1/chat/completions
# The model has to be able to see images. This is the only place it is named.
REBOT_LLM_MODEL=Qwen3.8-27B
# Bearer token, if the endpoint wants one (Ollama does not).
REBOT_LLM_TOKEN=
# One turn's budget. A 1280x720 still is ~100 KB of base64, and a vision turn on
# a local model is slow: keep the timeout generous.
REBOT_LLM_TEMPERATURE=0.2
REBOT_LLM_MAX_TOKENS=1024
# Context window. 0 reads meta.n_ctx from the endpoint's /v1/models (llama.cpp);
# set it explicitly for a server that does not expose one. This drives the
# page's compaction, not max_tokens.
REBOT_LLM_CONTEXT_TOKENS=0
REBOT_LLM_TIMEOUT=300
