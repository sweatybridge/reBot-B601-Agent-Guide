# Copy to .env and edit. Compose reads this file from this directory.
#
# The LAN address the phone can reach. After the WHIP handshake the phone sends
# video to <REBOT_HOST_IP>:8189/udp; a container's own IP would not work. It is
# also the address the certificate is issued for.
REBOT_HOST_IP=192.168.1.23

# Shared secret required on every upload and on /execute. Empty means "open on
# the LAN"; the arm gateway refuses /execute without the flag below, whatever
# this is set to.
REBOT_TOKEN=pick-something
REBOT_PLANNER_TOKEN=pick-something-internal

# Host port for the capture page.
REBOT_PORT=8443

# --- Where is the camera? ---------------------------------------------------
# A camera on a bracket needs no tag: fit its pose once with
#     docker compose --profile tools run --rm tools app/calibrate_extrinsics.py --auto --from <capture> --uv U V
# then set this to the rig it wrote. Empty means the handheld ArUco path below.
REBOT_EXTRINSICS=
# Refuse a capture whose background moved more than this since the fit, in
# pixels. 2 px is under 1 mm at 1 m with a phone sensor.
REBOT_WITNESS_MAX_PX=2.0
# The camera the automatic sweep uses. It must be the stream MediaMTX serves:
# the sweep is recorded by MediaMTX, so a snapshot URL or a USB device cannot be
# used here.
REBOT_CAMERA=rtsp://mediamtx:8554/phone
# Where MediaMTX writes recordings (`recordings/phone/*.mp4` on the host, /app/state
# inside the capture container) and the control API that starts and stops them.
REBOT_RECORDINGS=/app/state/recordings
REBOT_MEDIAMTX_API=http://mediamtx:9997

# Height of the surface being tapped, in the base frame.
REBOT_PLANE_Z=0.0
# The ArUco tag, in the arm's base frame: "x,y,z" or "x,y,z,yaw" in metres and
# DEGREES. Handheld mode: paste it upright on the side of the base and give the
# heading its printed face points to (180 for the -x face). Fixed mode does not
# use it. SIZE is the BLACK SQUARE's side, border included -- measure across the
# black, not the white margin: a 4 cm black square is 0.04. (The 4x4 pattern
# inside the border is only 4/6 of that, so do not measure it by mistake.)
REBOT_MARKER_AT=0.000,0.047,0.043,90
REBOT_MARKER_SIZE=0.04
# How a tap becomes a point: "fixed" uses the rig from one calibration sweep,
# "handheld" solves the camera from the base tag on every tap. Empty means
# "whatever this profile can do"; the page can switch per tap either way.
REBOT_MODE=
# How far above the tapped point the arm ends, in metres.
REBOT_HOVER_M=0.10
# Which local axis of gripper_end should point at the table (run `--inspect`),
# and the gripper yaw about vertical.
REBOT_TOOL_AXIS=current
REBOT_YAW=0

# The Pi, running `rebot-edge serve`. This is the only way the host reaches the
# arm: no ssh, no keys, no files copied onto the board.
REBOT_EDGE_URL=http://raspberrypi:8081
REBOT_EDGE_TOKEN=the-token-you-gave-rebot-edge-serve

# 0 = taps only produce trajectories on disk. 1 = the viewers also offer
# "Move the arm", behind a two-step confirm. The edge must also be started with
# --allow-execute; both flags are required.
REBOT_EXECUTE=0
