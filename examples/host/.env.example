# Copy to .env and edit. Compose reads this file from this directory.
#
# The LAN address the phone can reach. After the WHIP handshake the phone sends
# video to <REBOT_HOST_IP>:8189/udp; a container's own IP would not work. It is
# also the address the certificate is issued for.
REBOT_HOST_IP=192.168.1.23

# Shared secret required on every upload and on /execute. Empty means "open on
# the LAN"; the arm gateway refuses /execute without the flag below, whatever
# this is set to.
REBOT_TOKEN=pick-something
REBOT_PLANNER_TOKEN=pick-something-internal

# Host port for the capture page.
REBOT_PORT=8443

# The ArUco tag on the worktop, in the arm's base frame (see README).
# REBOT_TAG_SIZE is the black square including its border, in metres.
REBOT_TAG_SIZE=0.080
REBOT_TAG_X=0.35
REBOT_TAG_Y=-0.20
REBOT_TAG_YAW=15
# Height of the surface being tapped, in the base frame.
REBOT_PLANE_Z=0.0
# Which local axis of gripper_end should point at the table (run `--inspect`),
# and the gripper yaw about vertical.
REBOT_TOOL_AXIS=current
REBOT_YAW=0

# The Pi, running `rebot-edge serve`. This is the only way the host reaches the
# arm: no ssh, no keys, no files copied onto the board.
REBOT_EDGE_URL=http://raspberrypi:8081
REBOT_EDGE_TOKEN=the-token-you-gave-rebot-edge-serve

# 0 = taps only produce trajectories on disk. 1 = the viewers also offer
# "Move the arm", behind a two-step confirm. The edge must also be started with
# --allow-execute; both flags are required.
REBOT_EXECUTE=0
